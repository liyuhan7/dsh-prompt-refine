{
  "name": "dsh-prompt-refine",
  "version": "0.1.2",
  "description": "DSH Web Composer 提示词优化插件：发送前优化草稿或选中文字，采用 Prompt Engineering 技术进行优化",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyuhan7/dsh-prompt-refine.git"
  },
  "homepage": "https://github.com/liyuhan7/dsh-prompt-refine#readme",
  "bugs": { "url": "https://github.com/liyuhan7/dsh-prompt-refine/issues" },
  "keywords": ["dsh", "dsh-plugin", "prompt", "refine", "composer"],
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.bundle.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "scripts/build-client.js", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE", "docs/error-messages.md"],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/highlight-core.js && node --check lib/refinement-session.js && npm test",
    "build": "node scripts/build-client.js",
    "build:check": "node scripts/build-client.js --check",
    "pretest": "npm run build && node --check lib/client.bundle.js",
    "prepack": "npm run check && npm run build:check"
  },
  "peerDependencies": { "@deepseek-ai/schemastery": "^3.18.4" },
  "dsh": {
    "engines": { "dsh": "^0.1.7-rc.2" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-commands", "@deepseek-ai/dsh-client-ui-input-trigger"] }
  },
  "devDependencies": { "diff": "^9.0.0" }
}
